# Copie para .env e preencha. Nunca commite o .env.
GROQ_API_KEY=
GROQ_MODEL_CHAT=openai/gpt-oss-120b
GROQ_CHAT_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TTS_URL=https://api.groq.com/openai/v1/audio/speech
GROQ_MODEL_TTS=canopylabs/orpheus-v1-english
GROQ_MODEL_VISION=
GROQ_MODEL_AUDIO=
TELEGRAM_BOT_TOKEN=
MCP_TOKEN=
MCP_PUBLIC_URL=
USE_REMOTE_MCP=true
# O MCP escuta localmente por padrão. Use MCP_HOST=0.0.0.0 quando o deploy exigir.
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_STATELESS_HTTP=false
DB_PATH=db.sqlite
